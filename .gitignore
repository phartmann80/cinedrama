# Root gitignore — applies across the whole monorepo

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
.next/
out/
dist/
build/
*.tsbuildinfo

# Env files
.env
.env.local
.env.*.local
.env.production

# OS
.DS_Store
Thumbs.db
*.pem

# Editors
.vscode/settings.json
.idea/
*.suo
*.user

# Expo / React Native
.expo/
android/
ios/
web-build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
*.jks
*.p8
*.p12
*.key
*.mobileprovision
