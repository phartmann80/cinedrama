# Copy to .env and fill in values — never commit .env

# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL — required to serve dramas/episodes/auth)
DATABASE_URL=postgresql://user:password@localhost:5432/cinedrama

# JWT signing + HMAC media-gateway signing.
# JWT_SECRET is canonical. SESSION_SECRET is accepted as a fallback.
JWT_SECRET=change_me_in_production

# CORS — comma-separated allowed origins. Use * only in local development.
CORS_ORIGINS=http://localhost:3000,https://cinedrama.app

# Optional: Cloudflare R2 / AWS S3 (CDN origin the media gateway proxies)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=cinedrama-videos
# R2_PUBLIC_URL=https://cdn.cinedrama.app
