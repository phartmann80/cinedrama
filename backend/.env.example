# Copy to .env and fill in values — never commit .env

# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL — required in production, optional in mock-data dev mode)
DATABASE_URL=postgresql://user:password@localhost:5432/cinedrama

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_in_production

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,https://cinedrama.app

# Cloudflare R2 / AWS S3 (for presigned video URLs — optional in mock mode)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=cinedrama-videos
# R2_PUBLIC_URL=https://cdn.cinedrama.app
