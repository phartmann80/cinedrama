# /etc/cinedrama/backend.env
#
# Copy this template and fill in real values.
# NEVER commit the filled-in file. It lives at /etc/cinedrama/backend.env
# on the VPS (mode 0600, owned by cinedrama user).
#
# The provision-postgres.sh script generates this file automatically
# with strong random secrets. Use this template only for manual setup.

NODE_ENV=production

# Server
PORT=5000

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Generate the password with: openssl rand -base64 32 | tr -d '/+=' | head -c 40
DATABASE_URL=postgresql://cinedrama:CHANGE_ME@localhost:5432/cinedrama

# JWT signing secret (also used for HMAC media gateway)
# Generate with: openssl rand -base64 48
JWT_SECRET=GENERATE_WITH_openssl_rand_base64_48

# CORS - comma-separated allowed origins
# In production, list your exact domains. Never use * in production.
CORS_ORIGINS=https://cinedrama.app
