# CineDrama Web — optional GitHub Actions deploy (SSH/rsync)
#
# Copy this file to .github/workflows/deploy-web.yml when you're ready to wire
# credentials. Do NOT commit secrets — use repo/org Actions secrets.
#
# Secrets required (repo → Settings → Secrets and variables → Actions):
#   VPS_HOST, VPS_USER, VPS_PORT, VPS_SSH_KEY,
#   NEXT_PUBLIC_APK_URL, NEXT_PUBLIC_API_BASE_URL
#
# This deploy builds on the VPS (same mechanics as deploy/scripts/deploy-web.sh).
# It triggers only when web/ or the workflow itself changes on main.

name: Deploy Web

on:
  push:
    branches: [main]
    paths:
      - 'web/**'
      - '.github/workflows/deploy-web.yml'

jobs:
  deploy:
    name: Build + deploy web to VPS
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up SSH
        run: |
          mkdir -p ~/.ssh
          echo "${{ secrets.VPS_SSH_KEY }}" > ~/.ssh/deploy_key
          chmod 600 ~/.ssh/deploy_key
          ssh-keyscan -p "${VPS_PORT:-22}" "$VPS_HOST" >> ~/.ssh/known_hosts
        env:
          VPS_HOST: ${{ secrets.VPS_HOST }}
          VPS_PORT: ${{ secrets.VPS_PORT }}

      - name: Deploy
        timeout-minutes: 20
        env:
          WEB_DEPLOY_HOST: ${{ secrets.VPS_HOST }}
          WEB_DEPLOY_USER: ${{ secrets.VPS_USER }}
          WEB_DEPLOY_PORT: ${{ secrets.VPS_PORT }}
          NEXT_PUBLIC_APK_URL: ${{ secrets.NEXT_PUBLIC_APK_URL }}
          NEXT_PUBLIC_API_BASE_URL: ${{ secrets.NEXT_PUBLIC_API_BASE_URL }}
        run: |
          export GIT_SSH_COMMAND="ssh -i ~/.ssh/deploy_key -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -p ${WEB_DEPLOY_PORT:-22}"
          bash deploy/scripts/deploy-web.sh

      - name: Smoke test
        run: bash deploy/scripts/smoke-test-web.sh "https://cinedrama.app"
