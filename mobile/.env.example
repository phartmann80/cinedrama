# Copy to .env and fill in values
# Expo reads vars prefixed with EXPO_PUBLIC_ at build time

# CineDrama backend API
EXPO_PUBLIC_API_URL=https://api.cinedrama.app

# Google AdMob App ID (replace with your own from AdMob console)
EXPO_PUBLIC_ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
EXPO_PUBLIC_ADMOB_REWARDED_AD_UNIT=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# RevenueCat API key (from RevenueCat dashboard → Android app)
EXPO_PUBLIC_REVENUECAT_API_KEY=appl_XXXXXXXXXXXXXXXXXXXXXXXX
